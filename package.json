{
  "name": "travel-buddy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "隨身旅伴 TravelBuddy（日本版）：不會日文也能在日本 10 秒內把事情辦完。替你念出日文，或放大給對方看。",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node -e \"require('fs').copyFileSync('site/index.html', 'dist/index.html')\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "^10.6.1",
    "happy-dom": "^21.0.3",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "qrcode-generator": "^2.0.4"
  }
}
